# Copy to .env.local and fill in. All are optional — the site falls back to
# clearly-marked placeholders and flags them in the UI with a "TBC" badge.

# Shown in the contact section and the command palette's "copy email" action.
NEXT_PUBLIC_CONTACT_EMAIL=

# Where the Resume buttons point. Leave blank to serve the bundled
# /Sujith_C_Resume.pdf from the public/ folder instead.
NEXT_PUBLIC_RESUME_URL=

# Canonical origin, used for metadata and the social card.
NEXT_PUBLIC_SITE_URL=https://sujithc.dev
