# Copy to .env.local and fill in. Every value is optional — the site falls
# back to the values in content/profile.ts, and hides any affordance whose
# target is missing rather than rendering a dead link.

# Canonical origin. Used for metadata, the social card and the sitemap.
NEXT_PUBLIC_SITE_URL=https://sujith-portfolio-two.vercel.app

# Public contact email shown in Connect. Defaults to the address in
# content/profile.ts when blank.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public phone number. Deliberately NOT shown unless you set it here.
NEXT_PUBLIC_CONTACT_PHONE=

# Where the Resume buttons point. Blank serves /Sujith_C_Resume.pdf from
# the public/ folder. Set to "off" to hide every Resume affordance.
NEXT_PUBLIC_RESUME_URL=
